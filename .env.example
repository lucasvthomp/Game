# Marcamar environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Required in production
DATABASE_URL=
SESSION_SECRET=

# Optional admin bootstrap (created on startup when both values are present)
# Use a unique password of at least 12 characters. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Equipe Marcamar
ADMIN_USERNAME=marcamar-admin

# Verification provider
# manual is the safe MVP fallback. Datavalid requires a separate SERPRO contract and adapter.
IDENTITY_PROVIDER=manual

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional client map provider; when present, all interactive maps use Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# Marine data provider (informational only; not a navigation/safety guarantee)
MARINE_WEATHER_PROVIDER=openmeteo
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# Marketplace pricing
PLATFORM_FEE_PERCENTAGE=15

# Payment provider (required before collecting money)
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
