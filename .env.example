# Marcamar environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Required in production
DATABASE_URL=
SESSION_SECRET=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Marine data provider (informational only; not a navigation/safety guarantee)
MARINE_WEATHER_PROVIDER=openmeteo
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# Marketplace pricing
PLATFORM_FEE_PERCENTAGE=15

# Payment provider (required before collecting money)
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
